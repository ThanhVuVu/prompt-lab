# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets.

# ── Stage 2: server basics ───────────────────────────────────────────
NODE_ENV=development          # development | test | production
PORT=3000
LOG_REQUESTS=true             # log one line per request (middleware/logging.ts)

# ── Stage 7: observability ───────────────────────────────────────────
LOG_LEVEL=info                # error | warn | info | http | debug
LOG_FORMAT=pretty             # pretty (dev) | json (production)
# METRICS_TOKEN=              # set to protect GET /metrics

# ── Stage 4: database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prompt_lab_dev
# Used by `npm test` — a SEPARATE database that tests are allowed to wipe.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prompt_lab_test

# ── Stage 5: auth ────────────────────────────────────────────────────
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# ── Stage 6: queue + Claude API ──────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Get a key at https://platform.claude.com — only the worker (npm run worker) needs it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — how hard Claude thinks (and how many tokens it spends)
CLAUDE_EFFORT=low
WORKER_CONCURRENCY=2

# ── Stage 9: production hardening ────────────────────────────────────
LOGIN_RATE_LIMIT=10           # login attempts per IP+email per 15 minutes
TRUST_PROXY_HOPS=0            # 1 on Fly.io (its edge proxy sits in front of the app)
