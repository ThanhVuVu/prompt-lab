# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets.

# ── Stage 2: server basics ───────────────────────────────────────────
NODE_ENV=development          # development | test | production
PORT=3000
LOG_REQUESTS=true             # print one line per request (middleware/logging.ts)

# ── Stage 4: database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prompt_lab_dev
# Used by `npm test` — a SEPARATE database that tests are allowed to wipe.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prompt_lab_test

# ── Stage 5: auth (not used yet) ─────────────────────────────────────
# JWT_SECRET=change-me-to-a-long-random-string

# ── Stage 6: queue + Claude API (not used yet) ───────────────────────
# REDIS_URL=redis://localhost:6379
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5
