{
  "name": "prompt-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt Laboratory — version, test, and optimize Claude prompts. A backend learning project.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "stage1": "tsx watch stage1/hello-server.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:stage1": "jest tests/stage1",
    "test:stage2": "jest tests/stage2",
    "test:stage3": "jest tests/stage3",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:stage4": "jest tests/stage4",
    "test:stage5": "jest tests/stage5",
    "test:stage6": "jest tests/stage6",
    "test:stage7": "jest tests/stage7",
    "test:stage8": "jest tests/stage8",
    "test:stage9": "jest tests/stage9",
    "test:stage10": "jest tests/stage10"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
